# AutoShift Configuration - Extended Booking Window
# Copy this file to .env and fill in your credentials

# ============================================================================
# BOOKING WINDOW SETTINGS (EXTENDED)
# ============================================================================
# How many days in advance to book shifts (default: 75 days = ~2.5 months)
# Changed from typical 21-30 days to allow 2+ months advance booking
BOOKING_WINDOW_DAYS=75

# Buffer days before booking starts
BOOKING_BUFFER_DAYS=3

# Calendar sync window (should match or exceed booking window)
CALENDAR_SYNC_DAYS=75

# ============================================================================
# SOFTADMIN CREDENTIALS
# ============================================================================
SOFTADMIN_USERNAME=your_username_here
SOFTADMIN_PASSWORD=your_password_here
SOFTADMIN_BASE_URL=https://grona.softadmin.se

# ============================================================================
# GOOGLE CALENDAR (Optional)
# ============================================================================
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# ============================================================================
# AUTO-BOOKING SETTINGS
# ============================================================================
AUTO_BOOK_ENABLED=true
BOOK_SPECIFIC_ROLES=
MAX_SHIFTS_PER_WEEK=5
SYNC_TO_CALENDAR=true
